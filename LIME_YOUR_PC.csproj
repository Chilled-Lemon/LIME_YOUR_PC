<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LIME_YOUR_PC</AssemblyName>
    <RootNamespace>LIME_YOUR_PC</RootNamespace>
    <Version>0.6.1</Version>
    <FileVersion>0.6.1.0</FileVersion>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LIME_YOUR_PC.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\LIME_YOUR_PC.ico" />
    <Resource Include="Assets\LIME_YOUR_PC_icon.png" />
  </ItemGroup>
</Project>
