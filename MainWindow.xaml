<Window x:Class="LIME_YOUR_PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LIME_YOUR_PC"
        Width="1040" Height="760"
        MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="/Assets/LIME_YOUR_PC.ico"
        StateChanged="MainWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="82"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#252B2E"
            BorderThickness="1">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="12" Background="#151A17" BorderBrush="#334036" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="/Assets/LIME_YOUR_PC_icon.png" Width="44" Height="44" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LIME_YOUR_PC" FontFamily="Segoe UI Semibold" FontSize="25"/>
                    <TextBlock Text="Windows Gaming Optimizer · v0.6.1" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1B261D" BorderBrush="#405A43" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource LemonBrush}" FontSize="10" Margin="0,1,7,0"/>
                        <TextBlock Text="管理员权限 ✓" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" ToolTip="最小化" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" ToolTip="最大化" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeButton_Click"/>
                    <Button Content="&#xE8BB;" ToolTip="关闭" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: scrolls gracefully on smaller windows -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="系统信息" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                            <TextBlock x:Name="CpuNameText" Text="正在检测硬件…" FontSize="17" FontFamily="Segoe UI Semibold" TextWrapping="Wrap" Margin="0,9,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="设备类型" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="DeviceTypeText" Text="—" Margin="0,3,0,12"/>
                                    <TextBlock Text="物理核心 / 逻辑处理器" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="CoreText" Text="—" Margin="0,3,0,12"/>
                                    <TextBlock Text="核心拓扑" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="CoreTopologyText" Text="—" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="CPU 平台" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="CpuPlatformText" Text="—" Margin="0,3,0,12"/>
                                    <TextBlock Text="调度策略" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ScheduleText" Text="—" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="优化项目" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                                <TextBlock Text="  ·  仅修改 AC / 接通电源" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="✓  USB 省电与 USB3 Link Power&#x0a;✓  CPU 提升阈值、核心停放、节流状态&#x0a;✓  CPU Idle 阈值与性能检测间隔&#x0a;✓  最小处理器状态与异类调度策略&#x0a;✓  显示器超时（AC）设为从不"
                                       Foreground="{StaticResource TextBrush}" LineHeight="25" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="系统调整" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                            <TextBlock Text="独立开关 · 修改后立即验证" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="提高指针精确度" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="MouseTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="MouseTweakButton" Grid.Column="1" Content="—" Width="92" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="MouseTweakButton_Click" IsEnabled="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows 通知" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="NotificationsTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="NotificationsTweakButton" Grid.Column="1" Content="—" Width="92" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="NotificationsTweakButton_Click" IsEnabled="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows 自动更新" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="UpdateTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="UpdateTweakButton" Grid.Column="1" Content="—" Width="92" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="UpdateTweakButton_Click" IsEnabled="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Defender 实时保护" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="DefenderTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="DefenderTweakButton" Grid.Column="1" Content="—" Width="92" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="DefenderTweakButton_Click" IsEnabled="False"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="安全 / 高级" Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="内存完整性 (HVCI)" FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                                        <Border Background="#332D1A" BorderBrush="#665B2A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="7,0,0,0">
                                            <TextBlock Text="需重启" Foreground="{StaticResource WarningBrush}" FontSize="9" FontFamily="Segoe UI Semibold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="MemoryIntegrityTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="MemoryIntegrityTweakButton" Grid.Column="1" Content="—" Width="112" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="MemoryIntegrityTweakButton_Click" IsEnabled="False"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="基于虚拟化的安全性 (VBS)" FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                                        <Border Background="#332D1A" BorderBrush="#665B2A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="7,0,0,0">
                                            <TextBlock Text="需重启" Foreground="{StaticResource WarningBrush}" FontSize="9" FontFamily="Segoe UI Semibold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="VbsTweakStatusText" Text="检测中…" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="VbsTweakButton" Grid.Column="1" Content="—" Width="112" Padding="10,7" Style="{StaticResource GhostButtonStyle}" Click="VbsTweakButton_Click" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="电源优化安全性" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                            <TextBlock Text="DC / 电池参数永不写入" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,9,0,7"/>
                            <TextBlock Text="• 只修改当前目标计划的 AC（接通电源）参数&#x0a;• 不会删除或覆盖 Windows 原有电源计划&#x0a;• 不会修改 DC（电池）参数&#x0a;• 重复运行时复用已有 LIME_YOUR_PC 计划"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right side -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Software-side response benchmark -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="系统响应测试" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                                <TextBlock Text="Windows 定时唤醒与线程调度响应" FontFamily="Segoe UI Semibold" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#20262A" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                <TextBlock x:Name="BenchmarkBadgeText" Text="尚未测试" Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe UI Semibold" FontSize="10"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="这是软件侧 A/B 测试，不代表鼠标到显示器的端到端输入延迟。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,7,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="平均响应延迟" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                <TextBlock x:Name="BenchmarkAverageText" Text="—" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="偶发响应延迟" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                <TextBlock x:Name="BenchmarkOccasionalText" Text="—" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="响应抖动" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                <TextBlock x:Name="BenchmarkJitterText" Text="—" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="最大延迟尖峰" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                <TextBlock x:Name="BenchmarkWorstText" Text="—" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="BenchmarkConclusionText" Text="可先测试当前状态；随后一键优化会直接复用这次结果，不重复测试优化前。"
                                   Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="BenchmarkBaselineText" Text="跨重启对比基准：未保存（VBS / HVCI 等场景可用）" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,8" TextWrapping="Wrap"/>

                        <ProgressBar x:Name="BenchmarkProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Background="#2A3035" Foreground="{StaticResource LemonBrush}" BorderThickness="0"/>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BenchmarkEnvironmentText" Text="建议关闭大型后台任务后测试" Foreground="{StaticResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="SaveBenchmarkBaselineButton" Grid.Column="1" Content="保存对比基准" Width="106" ToolTip="用于 VBS / HVCI 等重启后的手动 A/B 对比" Padding="9,6" Style="{StaticResource GhostButtonStyle}" Click="SaveBenchmarkBaselineButton_Click" IsEnabled="False"/>
                            <Button x:Name="RunBenchmarkButton" Grid.Column="3" Content="测试当前状态" Width="112" ToolTip="测试后若直接一键优化，本次结果会自动作为优化前基准" Padding="9,6" Style="{StaticResource GhostButtonStyle}" Click="RunBenchmarkButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Run status / log -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="运行状态" Foreground="{StaticResource LemonBrush}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                                <TextBlock x:Name="StatusTitleText" Text="准备就绪" FontFamily="Segoe UI Semibold" FontSize="18" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#20262A" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText" Text="准备就绪" Foreground="{StaticResource MutedTextBrush}" FontFamily="Segoe UI Semibold" FontSize="11"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#101214" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" Text="等待开始…" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#C7D0CD" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="4">
                            <ProgressBar x:Name="MainProgress" Height="6" Minimum="0" Maximum="100" Value="0" Background="#2A3035" Foreground="{StaticResource LemonBrush}" BorderThickness="0"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SummaryText" Text="尚未运行" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="OpenLogButton" Grid.Column="1" Content="打开日志文件" Style="{StaticResource GhostButtonStyle}" Click="OpenLogButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer / primary CTA -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="偏向游戏性能与响应速度" FontFamily="Segoe UI Semibold" FontSize="13"/>
                <TextBlock Text="主按钮仅修改 AC 电源参数，并自动进行软件侧响应 A/B 测试；系统调整需单独操作。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="▶  应用 LIME 优化" Width="310" Height="58" Foreground="#0A0D0B" FontWeight="SemiBold" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
    </Border>
</Window>
